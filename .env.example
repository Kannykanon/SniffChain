# Optional: provider endpoints (Alchemy, QuickNode, dRPC, Blockdaemon). Public RPCs rate-limit hard.
ARC_RPC_URL=https://rpc.mainnet.arc.io
BASE_RPC_URL=https://mainnet.base.org

# Plain-English explanation layer (same design as ArcGuard): anthropic | groq | grok | gemini | openai
LLM_PROVIDER=groq
# LLM_MODEL=            # optional: pin a model instead of the provider default
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Only for scripts/deploy.py (ATTESTER_PRIVATE_KEY also works). Never commit a real key.
DEPLOYER_PRIVATE_KEY=
